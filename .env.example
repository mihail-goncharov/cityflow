# CityFlow Docker Compose example configuration.
# Copy to .env, set credentials, and NEVER commit .env to Git.

# Laptop: use an ignored local directory.
# Proxmox VM: change to /srv/cityflow (data will be /srv/cityflow/rustfs).
CITYFLOW_DATA_DIR=./.local/data

# Official RustFS image. For repeatable deployments pin a tested immutable
# version/digest after initial verification; do not update blindly.
RUSTFS_IMAGE=rustfs/rustfs:latest

# Docker binds ports to this VM/laptop interface only.
# 127.0.0.1 = safe default, local access only.
# For Mac access over Tailscale: replace with CityFlow VM's Tailscale 100.x IP.
RUSTFS_BIND_IP=127.0.0.1
RUSTFS_S3_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# REQUIRED: do not leave blank. Use unique credentials per environment.
# e.g. RUSTFS_ACCESS_KEY=cityflow-local
#      RUSTFS_SECRET_KEY=<generated using openssl rand -hex 32>
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=

# S3 client (boto3). Personal keys from the RustFS admin.
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=cityflow-dev